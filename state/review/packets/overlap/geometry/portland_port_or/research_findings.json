  "build_method": {
    "area_crs": "EPSG:5070",
    "geometry_method": "Repair invalid source geometries, dissolve the full official property layer into a discontiguous union, intersect that union with 2020 Oregon TIGER block groups, and convert intersection areas to normalized shares.",
    "why_this_is_defensible": [
      "The Port itself curates the exact parcel system in a dedicated Port of Portland Properties layer.",
      "Current Port pages corroborate the major operational asset classes expected in the footprint: airports, terminals, air cargo, business parks, and industrial districts.",
      "Dissolving the official layer removes about 97.75 acres of overlap or duplicate accounting from the raw parcel rows before share generation."
    ],
    "why_all_rows_are_retained": [
      "The official layer name indicates the polygons are all part of the Port property system, not a generic regional parcel pull.",
      "The non-Port owner rows are concentrated in Hillsboro airport hangar or condo parcels plus a very small number of embedded industrial or blank-owner slivers already curated inside the layer.",
      "Current Port pages explicitly describe leased terminal operations and airport business activity, so trimming the layer to Port-owned-only strings would understate the real Port property system."
    ]
  },
