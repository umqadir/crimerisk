# Single point of control for the frozen-snapshot build chain (01/03/04/05).
# Shell-sourceable KEY=VALUE lines; the Python steps parse the same file.
#
# CRIMERISK_SNAPSHOT_YEAR drives the published population column
# (population_<year>), the snapshot data_year, and the PMTiles filename
# (crimerisk_block_groups_<year>.pmtiles). CRIMERISK_SNAPSHOT_SRC is the
# repo-relative published block-group parquet the snapshot is frozen from.
CRIMERISK_SNAPSHOT_YEAR=2024
CRIMERISK_SNAPSHOT_SRC=state/candidates/houston-batch-c-v15/crimerisk_block_group_2024_ags_core.parquet
